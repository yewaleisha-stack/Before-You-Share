{
  "name": "before-you-share",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Redact emails, phones, IPs, PAN, Aadhaar and card numbers in the browser before you share.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-landing.mjs",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:cloudrun": "gcloud run deploy before-you-share --source . --region asia-south1 --allow-unauthenticated"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
